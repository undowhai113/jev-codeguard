# TypeSafe AI Jev API key (alternatively saved via `npx mcp-jev setup --api-key jev_live_...` to ~/.mcp-jev/config.json)
JEV_API_KEY=jev_live_your_key_here

# Opt-in Autopilot mode: set to 1 to allow jev_autopilot_decide to return AUTOPILOT_PROCEED on high-confidence reversible technical choices (default: 0 / ASK_HUMAN)
JEV_AUTOPILOT=0

# Optional: Custom directory containing local SKILL.md security/animation rubrics
# JEV_SKILLS_DIR=/path/to/your/skills

# Optional: PreToolUse Hook fail mode when Jev API is unreachable ("ask" | "open" | "closed", default: "ask")
# JEV_FAIL_MODE=ask

# Optional: Extra workspace parent directories (delimited by ':' on POSIX or ';' on Windows) for automatic project root resolution
# JEV_WORKSPACE_ROOTS=/path/to/projects
