{
  "name": "jev-codeguard",
  "version": "1.0.0",
  "description": "Command firewall, AST security auditor, context pruner & zero-token git diff verifier for AI coding agents (Claude Code, Codex, Cursor, Gemini) — powered by TypeSafe AI Jev",
  "type": "module",
  "main": "./dist/src/cli/index.js",
  "types": "./dist/src/core/types.d.ts",
  "bin": {
    "jev-codeguard": "./dist/src/cli/index.js",
    "mcp-jev": "./dist/src/cli/index.js",
    "jev-gate": "./dist/src/cli/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/undowhai113/jev-codeguard.git"
  },
  "homepage": "https://github.com/undowhai113/jev-codeguard#readme",
  "bugs": {
    "url": "https://github.com/undowhai113/jev-codeguard/issues"
  },
  "files": [
    "dist/src",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "tsc && node -e \"import('node:fs').then(async fs => { const { execFileSync } = await import('node:child_process'); const files = fs.readdirSync('dist/tests').filter(f => f.endsWith('.test.js')).map(f => 'dist/tests/' + f); execFileSync(process.execPath, ['--test', ...files], { stdio: 'inherit' }); })\"",
    "prepublishOnly": "npm test",
    "start": "node dist/src/cli/index.js serve",
    "dashboard": "node dist/src/cli/index.js dashboard",
    "gate": "node dist/src/cli/index.js gate",
    "setup": "node dist/src/cli/index.js setup"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "jev",
    "typesafe",
    "system-one",
    "coding-agent",
    "claude-code",
    "codex",
    "cursor",
    "antigravity",
    "gemini",
    "security-audit",
    "guardrails",
    "ast",
    "oxlint",
    "ruff",
    "codegraph"
  ],
  "author": "Ahair",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "oxlint": "^1.90.0",
    "ts-morph": "^28.0.0",
    "zod": "^4.6.7"
  },
  "overrides": {
    "minimatch": "^11.0.9",
    "hono": "^4.13.19",
    "@hono/node-server": "^2.1.8"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
